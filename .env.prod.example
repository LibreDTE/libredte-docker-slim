# LibreDTE Slim — producción.
#
#   cp .env.prod.example .env
#   (completa las variables obligatorias, abajo)
#   docker compose up -d
#   docker compose logs -f setup   # espera "==> Listo"
#
# Este archivo es SOLO tuyo: el stack nunca lo modifica. Está incluido en los
# respaldos (perfil `backup`) porque `DB_PASSWORD` solo vive aquí.
#
# Las líneas comentadas (`#VARIABLE=valor`) muestran el valor por defecto.

# ---------------------------------------------------------------------------
# Obligatorias
# ---------------------------------------------------------------------------

# Dominio del sitio, tal como se escribe en el navegador (con puerto solo si no
# es 80/443). Slim solo acepta peticiones para este dominio.
SITE_HOSTNAME=

# Contraseña de la base de datos. Se usa al crear la base por primera vez:
# cambiarla después en este archivo NO la cambia en PostgreSQL.
DB_PASSWORD=

# ---------------------------------------------------------------------------
# Sitio y TLS
# ---------------------------------------------------------------------------

# Qué atiende Caddy (obligatoria): el dominio de SITE_HOSTNAME (obtiene y
# renueva un certificado de Let's Encrypt solo; requiere los puertos 80 y 443
# alcanzables y el DNS apuntando al servidor) o `:80` (HTTP plano, para ir detrás
# de otro proxy como Traefik: ver overrides/traefik.yaml).
SITE_ADDRESS=
# https cuando hay TLS (Caddy o un proxy delante).
SITE_URL_SCHEMA=https
# Otros hosts por los que se accede (sin puerto), separados por espacio.
#SITE_EXTRA_HOSTS=

# Puertos del host. En producción, 80 y 443 en todas las interfaces.
HTTP_BIND=0.0.0.0
HTTP_PORT=80
HTTPS_PORT=443

# Tamaño máximo de una subida (planillas de emisión masiva, certificados, logos).
#UPLOAD_MAX_SIZE=32M

# ---------------------------------------------------------------------------
# Datos de demostración
# ---------------------------------------------------------------------------

# 0 en producción. Con 1 se crea el usuario público `demo` / `Slim123%` y datos
# de ejemplo: nunca en un servidor expuesto. Pasar de una instalación con demo a
# producción es partir de volúmenes nuevos (`docker compose down -v`).
SLIM_SEED_DEMO=0

# ---------------------------------------------------------------------------
# Servicios opcionales (separados por coma): backup, mailpit, tools
# ---------------------------------------------------------------------------

# `backup` respalda base de datos, media, secretos y este .env cada
# BACKUP_INTERVAL_HOURS horas, durante BACKUP_KEEP_DAYS días.
COMPOSE_PROFILES=backup
#BACKUP_INTERVAL_HOURS=24
#BACKUP_KEEP_DAYS=7

# Para llevar los datos a directorios del host (recomendado) y/o publicar el
# sitio con un Traefik existente, lista los overrides separados por `:`:
#COMPOSE_FILE=compose.yaml:overrides/local-dirs.yaml
#COMPOSE_FILE=compose.yaml:overrides/local-dirs.yaml:overrides/traefik.yaml
#DATA_DIR=./data
#TRAEFIK_HOST=
#TRAEFIK_NETWORK=shared_network

# ---------------------------------------------------------------------------
# Secretos de la aplicación
# ---------------------------------------------------------------------------

# Si los dejas vacíos, `setup` los genera la primera vez y los guarda en el
# volumen `state` (entra en los respaldos). Puedes fijarlos aquí.
#
# FIELD_ENCRYPTION_KEY cifra la clave privada de los certificados digitales:
# si se pierde, los certificados guardados no se pueden leer. Cambiarla aquí
# con datos ya guardados hace fallar a `setup` a propósito (ver el README).
#SECRET_KEY=
#FIELD_ENCRYPTION_KEY=

# ---------------------------------------------------------------------------
# Correo (SMTP): avisos de la emisión masiva, recuperación de contraseña
# ---------------------------------------------------------------------------

# Sin EMAIL_HOST, Slim imprime los correos en el log en vez de enviarlos.
#EMAIL_HOST=smtp.example.com
# Sin EMAIL_PORT, se deduce de SSL/TLS.
#EMAIL_PORT=465
#EMAIL_USE_SSL=1
#EMAIL_USE_TLS=0
#EMAIL_HOST_USER=
#EMAIL_HOST_PASSWORD=
# Sin definir, se usa EMAIL_HOST_USER.
#DEFAULT_FROM_EMAIL=

# ---------------------------------------------------------------------------
# Servicios externos (opcionales)
# ---------------------------------------------------------------------------

# Cuenta de https://www.apigateway.cl para las consultas al SII. Sin token,
# esas consultas no están disponibles.
#PLUGIN_APIGATEWAYCL_API_URL=https://app.apigateway.cl
#PLUGIN_APIGATEWAYCL_API_TOKEN=

# La Core API del stack no pide token. Solo si apuntas a otra que lo exija
# (la URL del backend la fija el stack).
#PLUGIN_LIBREDTE_BACKEND_API_TOKEN=

# ---------------------------------------------------------------------------
# Versiones
# ---------------------------------------------------------------------------

# Código de Slim: vacío = último commit de la rama por defecto del repositorio;
# con un tag (ej. v0.1.0b1) se fija esa versión. Cambiarlo requiere
# `docker compose build` y `docker compose up -d`.
#SLIM_REPO=https://github.com/LibreDTE/libredte-app-slim.git
#SLIM_VERSION=

# LibreDTE Lib Core API no publica versiones numeradas: `latest` es la última.
# Se puede fijar a un commit (tag de 40 caracteres hexadecimales, el hash de su
# repositorio): en ese caso el pie de Slim muestra la versión exacta del backend.
#CORE_API_VERSION=latest
#LIBREDTE_BACKEND_COMMIT=

#POSTGRES_VERSION=18
#VALKEY_VERSION=9.2
#CADDY_VERSION=2.11
#MAILPIT_VERSION=v1.31

# ---------------------------------------------------------------------------
# Ajustes
# ---------------------------------------------------------------------------

#TZ=America/Santiago
#LOG_LEVEL=INFO
# Rotación de los logs de Docker.
#LOG_MAX_SIZE=10m
#LOG_MAX_FILE=3

# Procesos: gunicorn (web) y Celery. Cada worker de emisión masiva procesa de a
# una tarea por proceso.
#WEB_WORKERS=3
#WEB_THREADS=4
#WORKER_CONCURRENCY=3
#WORKER_EMISION_MASIVA_CONCURRENCY=2

# Límites de memoria por servicio.
#DB_MEMORY_LIMIT=1g
#VALKEY_MEMORY_LIMIT=256m
#CORE_API_MEMORY_LIMIT=768m
#SETUP_MEMORY_LIMIT=1g
#WEB_MEMORY_LIMIT=1g
#WORKER_MEMORY_LIMIT=1g
#WORKER_EMISION_MASIVA_MEMORY_LIMIT=1g
#CADDY_MEMORY_LIMIT=256m
#CONSOLE_MEMORY_LIMIT=1g
#BACKUP_MEMORY_LIMIT=512m
