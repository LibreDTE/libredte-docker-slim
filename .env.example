# LibreDTE Slim — inicio rápido (localhost, con datos de demostración):
#
#   cp .env.example .env
#   docker compose up -d
#   docker compose logs -f setup   # espera "==> Listo"
#
# Entra a http://localhost:8080 con el usuario `demo` y la contraseña
# `Slim123%`. Estos valores son públicos: para un servidor usa
# .env.prod.example.
#
# Este archivo es SOLO tuyo: el stack nunca lo modifica. Los secretos de la
# aplicación (SECRET_KEY, FIELD_ENCRYPTION_KEY) los genera `setup` y quedan en
# el volumen `state`.

# Servicios opcionales: mailpit (recibe el correo que envía Slim, en el puerto
# MAILPIT_PORT), backup, tools.
COMPOSE_PROFILES=mailpit

# Dirección que atiende Caddy: `:80` es HTTP plano.
SITE_ADDRESS=:80
# Dominio (con puerto si no es 80/443) tal como lo escribes en el navegador, y
# su esquema.
SITE_HOSTNAME=localhost:8080
SITE_URL_SCHEMA=http

HTTP_BIND=127.0.0.1
HTTP_PORT=8080
HTTPS_PORT=8443
MAILPIT_PORT=8025

# Base de datos (no se publica fuera de la red del stack).
DB_PASSWORD=libredte

# Carga los datos de demostración (usuario, contribuyente, certificado y CAF
# ficticios, DTE de ejemplo). Sin la variable, no se cargan.
SLIM_SEED_DEMO=1

# Correo: todo el correo de Slim llega a Mailpit.
EMAIL_HOST=mailpit
EMAIL_PORT=1025
DEFAULT_FROM_EMAIL=slim@example.com
